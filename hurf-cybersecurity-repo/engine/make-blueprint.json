            {
              "id": 18,
              "mapper": {
                "text": "{{8.data}}",
                "value": "$1\n",
                "global": true,
                "pattern": "[\\s\\S]*?(eval\\s*\\(\\s*(?:atob|unescape|decodeURIComponent|escape|String\\.fromCharCode|function\\s*\\(\\s*p\\s*,\\s*a\\s*,\\s*c\\s*,\\s*k)[^<]{0,80}|document\\.write\\s*\\(\\s*(?:unescape|atob|String\\.fromCharCode)[^<]{0,80}|<iframe\\b[^>]{0,400}?(?:width\\s*=\\s*[\"']?0[\"'\\s>]|height\\s*=\\s*[\"']?[01][\"'\\s>]|display\\s*:\\s*none|visibility\\s*:\\s*hidden)[^>]{0,200}>|coinhive|cryptonight|coin-hive|crypto-loot|webminepool|<script\\b[^>]{0,200}?\\bsrc\\s*=\\s*[\"'][^\"'<>]{4,240}[\"']|String\\.fromCharCode\\s*\\(\\s*(?:\\d+\\s*,\\s*){24}|(?:var|let|const)\\s+_0x[0-9a-f]{4,}[^<]{0,40}|\\b(?:viagra|cialis|levitra|casino|online slots?|slot gacor|judi online|togel|payday loans?|replica watches|porn)\\b[^<]{0,60}|<meta\\b[^>]{0,200}http-equiv\\s*=\\s*[\"']?refresh[^>]{0,200}>|(?:window|document|top)\\.location(?:\\.href)?\\s*=\\s*[\"']https?://[^\"'<>]{4,160}[\"'])|[\\s\\S]+$",
                "multiline": false,
                "sensitive": false,
                "singleline": false
              },
              "module": "regexp:Replace",
              "version": 1,
              "metadata": {
                "designer": {
                  "x": 2200,
                  "y": -200,
                  "name": "Malware scan: extract scripts and suspicious code"
                }
              },
              "parameters": {}
            },
            {
              "id": 14,
              "mapper": {
                "text": "{{8.data}}",
                "value": "",
                "global": true,
                "pattern": "<style[\\s\\S]*?</style>",
                "multiline": false,
                "sensitive": false,
                "singleline": false
              },
              "module": "regexp:Replace",
              "version": 1,
              "metadata": {
                "designer": {
                  "x": 2250,
                  "y": 0,
                  "name": "Strip inline styles"
